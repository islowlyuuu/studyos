# 复制为 .env 后填入真实值
DATABASE_URL=postgresql+psycopg://studyos:studyos@localhost:5432/studyos
REDIS_URL=redis://localhost:6379/0

# DeepSeek（platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 本地 embedding 模型（bge-small-zh 是 512 维，bge-m3 是 1024 维）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

VECTOR_TOP_K=8
CACHE_TTL_SECONDS=3600

MAX_AGENT_STEPS=8
AGENT_TIMEOUT_SECONDS=60
