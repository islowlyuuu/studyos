{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudyOS Real Corpus Evaluation Set",
  "type": "object",
  "required": ["version", "items"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "topic", "expected_logical_key", "expected_version", "expected_chunk_ids", "expected_source", "key_answer_points", "forbidden_conclusions", "reviewed_by", "reviewed_at"],
        "properties": {
          "id": {"type": ["string", "integer"]},
          "question": {"type": "string", "minLength": 1},
          "topic": {"type": "string", "minLength": 1},
          "expected_logical_key": {"type": "string", "minLength": 1},
          "expected_version": {"type": "integer", "minimum": 1},
          "expected_chunk_ids": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
          "expected_source": {"type": "object"},
          "key_answer_points": {"type": "array", "items": {"type": "string"}},
          "forbidden_conclusions": {"type": "array", "items": {"type": "string"}},
          "reviewed_by": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
